# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# Groq Console. Leave empty to use the built-in demo responder.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Public deployment URL, without a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# true = the sample tenant works before Supabase/Groq is configured.
NEXT_PUBLIC_DEMO_MODE=true

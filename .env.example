# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# Google AI Studio. Leave empty to use the built-in demo responder.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Public deployment URL, without a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# true = the sample tenant works before Supabase/Gemini is configured.
NEXT_PUBLIC_DEMO_MODE=true
